# Fjord's name and logo in place of Firefox's (registered by Fjord.cfg)
override chrome://branding/locale/brand.properties branding/brand.properties
override chrome://branding/content/aboutDialog.css branding/aboutDialog.css
override chrome://branding/content/about-wordmark.svg branding/wordmark-light.svg
override chrome://branding/content/firefox-wordmark.svg branding/wordmark.svg
override chrome://branding/content/about-logo.svg branding/logo.png
override chrome://branding/content/about-logo.png branding/logo.png
override chrome://branding/content/about-logo@2x.png branding/logo.png
override chrome://branding/content/about-logo-private.png branding/logo.png
override chrome://branding/content/about-logo-private@2x.png branding/logo.png
override chrome://branding/content/about.png branding/logo.png
override chrome://branding/content/icon16.png branding/logo.png
override chrome://branding/content/icon32.png branding/logo.png
override chrome://branding/content/icon48.png branding/logo.png
override chrome://branding/content/icon64.png branding/logo.png
override chrome://branding/content/icon128.png branding/logo.png
override chrome://activity-stream/content/data/content/assets/splash-logo.svg branding/logo.png
# chrome://fjord/content/ = this folder, for pages that need Firefox's privileges (the sidebar apps' webpanel.html)
content fjord ./
# The picture-in-picture button over videos, in Fjord's look (pipToggle.css)
override chrome://global/skin/media/pipToggle.css pipToggle.css
# Fjord's blue shields on about:protections and in settings › Privacy, and Fjord's logo next to "About Fjord" in Firefox's settings
override chrome://browser/content/logos/tracking-protection.svg branding/shield.svg
override chrome://browser/content/logos/tracking-protection-dark-theme.svg branding/shield.svg
override chrome://browser/skin/sidebar/firefox.svg branding/logo.png
override chrome://global/skin/illustrations/shield-check.svg branding/shield.svg
override chrome://global/skin/illustrations/shield-alert.svg branding/shield-alert.svg
# Firefox's fox (Kit) and Firefox's logo, wherever Firefox draws them: illustrations become Fjord's fjord,
# one-colour icons Fjord's mountains. shortcut: names from Firefox 160; after a major update, look for new ones
# (any picture in omni.ja named kit, fox, mascot or firefox)
override chrome://global/skin/illustrations/kit-holding-lock.svg branding/fjord-scene.svg
override chrome://global/skin/illustrations/kit-confetti.svg branding/fjord-scene.svg
override chrome://mozapps/skin/extensions/kit-themes.svg branding/fjord-scene.svg
override chrome://global/skin/illustrations/kit-sympathetic.svg branding/fjord-scene.svg
override chrome://global/skin/illustrations/kit-in-circle.svg branding/fjord-scene.svg
override chrome://global/skin/illustrations/kit-concerned.svg branding/fjord-scene.svg
override chrome://global/content/megalist/icons/cpm-fox-illustration.svg branding/fjord-scene.svg
override chrome://global/skin/illustrations/kit-happy.svg branding/fjord-scene.svg
override chrome://mozapps/skin/extensions/kit-addons.svg branding/fjord-scene.svg
override chrome://browser/skin/fxa/avatar-fox-circle.svg branding/fjord-mono.svg
override chrome://browser/content/asrouter/assets/fox-with-checkmark.svg branding/fjord-scene.svg
override chrome://activity-stream/content/data/content/assets/br-amo-fox-paint.svg branding/fjord-scene.svg
override chrome://browser/content/controlcenter/assets/fox-concern.svg branding/fjord-scene.svg
override chrome://browser/skin/sidebar/foxy.svg branding/fjord-mono.svg
