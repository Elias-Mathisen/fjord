<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- fjord://open?url=… opens a page in Fjord (Shortcuts, other apps, and the simulator tests). The other keys are
	     generated from the build settings in tools/make-project.py -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.eliasmathisen.fjord</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fjord</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
